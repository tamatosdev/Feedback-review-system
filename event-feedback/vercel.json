{
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/api"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/monthly-send",
      "schedule": "0 9 28 * *"
    },
    {
      "path": "/api/cron/six-month-report",
      "schedule": "0 9 1 1,7 *"
    },
    {
      "path": "/api/cron/no-response-check",
      "schedule": "0 10 * * *"
    }
  ]
}