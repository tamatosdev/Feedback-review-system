# ===== Secrets — copy .env.example to .env and fill in =====

# Gemini API key (https://aistudio.google.com/apikey) — used for AI analysis
GEMINI_API_KEY=
# Gemini model (default gemini-3.6-flash; gemini-2.5-flash is deprecated for new accounts)
GEMINI_MODEL=gemini-3.6-flash

# Admin session auth — single fixed login protecting dashboard.html,
# admin-clients.html, /api/login, and the admin API endpoints
# (/api/clients, GET /api/feedback, /api/stats, /api/reports/combined, /api/cron/*).
# The public feedback form stays open. All three must be set; if any is missing,
# auth is disabled (local dev only) and a warning is logged at startup.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Secret for the Google Sheets "Sync Now" button (POST /api/clients/sync,
# header X-Sync-Secret). Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The endpoint UPSERTS clients by email (updates existing, inserts new).
# If unset, the endpoint refuses all requests (fail closed).
SYNC_SECRET=

# Postgres connection string (e.g. Neon/Supabase) — REQUIRED for production
# on Vercel (SQLite files don't persist on serverless). When set, the app
# uses Postgres; when empty, local SQLite (data/feedback.db) is used for dev.
DATABASE_URL=

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=tahir@puredesigners.com
SMTP_PASS=

# Admin email that receives every report (organizer)
ADMIN_EMAIL=tahir@puredesigners.com

# Public base URL used for PDF links inside emails (change when deployed)
PUBLIC_URL=http://localhost:3000

# ===== Phase 2 — automation layer =====

# SQLite database path (default: data/feedback.db, relative to project root)
DB_PATH=data/feedback.db

# Base URL used to build the monthly /feedback/<token> links (default: PUBLIC_URL)
APP_BASE_URL=

# Cron expressions for the scheduled jobs (node-cron 5-field format)
# Monthly form send to active clients — 09:00 on the 1st of every month
MONTHLY_SEND_CRON=0 9 1 * *
# 6-month combined trend report — 09:00 on Jan 1 and Jul 1
SIX_MONTH_REPORT_CRON=0 9 1 1,7 *

# Optional: secret required (via header "x-cron-secret") on the external
# /api/cron/* trigger endpoints. Leave empty to disable the check.
CRON_SECRET=

# Server port
PORT=3000
