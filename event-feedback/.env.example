# ===== Secrets — copy .env.example to .env and fill in =====

# Gemini API key (https://aistudio.google.com/apikey) — used for AI analysis
GEMINI_API_KEY=
# Gemini model (default gemini-3.6-flash; gemini-2.5-flash is deprecated for new accounts)
GEMINI_MODEL=gemini-3.6-flash

# Admin session auth — single fixed login protecting dashboard.html,
# admin-clients.html, /api/login, and the admin API endpoints
# (/api/clients, GET /api/feedback, /api/stats, /api/reports/combined, /api/cron/*).
# The public feedback form stays open. All three must be set; if any is missing,
# auth is disabled (local dev only) and a warning is logged at startup.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=

# Secret for the Google Sheets "Sync Now" button (POST /api/clients/sync,
# header X-Sync-Secret). Generate a random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# The endpoint UPSERTS clients by email (updates existing, inserts new).
# If unset, the endpoint refuses all requests (fail closed).
SYNC_SECRET=

# Public read-only CSV link of the client Google Sheet, published to the web
# (File → Share → Publish to web → "Comma-separated values (.csv)").
# Used by the "Sync from Google Sheet" button on the admin page
# (POST /api/clients/sync-from-sheet) to pull clients server-side without
# opening the sheet. If unset, the button returns a clear error (fail closed).
SHEET_CSV_URL=

# The normal shareable Google Sheet URL you open to EDIT it, e.g.
# https://docs.google.com/spreadsheets/d/<sheet-id>/edit — different from
# SHEET_CSV_URL (machine-readable pull source). Shown as the
# "Open Google Sheet" link on the admin client page (new tab). Not used for
# data; whoever clicks it needs edit access in Google. If unset, the link is
# hidden and a small note is shown instead.
SHEET_EDIT_URL=

# Postgres connection string (e.g. Neon/Supabase) — REQUIRED for production
# on Vercel (SQLite files don't persist on serverless). When set, the app
# uses Postgres; when empty, local SQLite (data/feedback.db) is used for dev.
DATABASE_URL=

# Hostinger SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=tahir@puredesigners.com
SMTP_PASS=

# Admin email that receives every report (organizer)
ADMIN_EMAIL=tahir@puredesigners.com

# Comma-separated leadership addresses that ALSO receive the full report email
# (with the attached PDF) whenever a submission's overall score
# (agency_leadership_score) is below ALERT_LOW_SCORE_THRESHOLD. Leave empty for
# none. Whitespace is trimmed and empty entries (e.g. trailing commas) ignored.
LEADERSHIP_EMAILS=Taha.Hashmi@craftsmenmedia.com, Owais.Riaz@craftsmenmedia.com, Ismat.Hashmi@craftsmenmedia.com

# Public base URL used for PDF links inside emails (change when deployed)
PUBLIC_URL=http://localhost:3000

# ===== Phase 2 — automation layer =====

# --- Report storage (generated HTML/PDF) ---
# The app never REQUIRES local disk for reports. Driver auto-selected:
#   - local dev:  "disk"  — writes to ./reports as always
#   - on Vercel without storage credentials: "memory" — nothing is written;
#     report links regenerate on demand from the database
#   - on Vercel with the two SUPABASE_* vars below: "supabase" — files are
#     uploaded to a Supabase Storage bucket and served from its public URL
# Set STORAGE_DRIVER=disk|supabase|memory to force a specific driver.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=reports
STORAGE_DRIVER=

# SQLite database path (default: data/feedback.db, relative to project root)
DB_PATH=data/feedback.db

# Base URL used to build the monthly /feedback/<token> links (default: PUBLIC_URL)
APP_BASE_URL=

# Cron expressions for the scheduled jobs (node-cron 5-field format)
# Monthly form send to active clients — 09:00 on the 28th of every month
MONTHLY_SEND_CRON=0 9 28 * *
# 6-month combined trend report — 09:00 on Jan 1 and Jul 1
SIX_MONTH_REPORT_CRON=0 9 1 1,7 *

# Optional: secret required (via header "x-cron-secret") on the external
# /api/cron/* trigger endpoints. Leave empty to disable the check.
CRON_SECRET=

# Phase 3 — no-response reminder threshold.
# Days an unanswered monthly feedback request is allowed to age before the
# client gets a "Gentle Reminder" email AND an internal alert to ADMIN_EMAIL.
# Default: 5.
ALERT_NO_RESPONSE_DAYS=5

# Server port
PORT=3000
